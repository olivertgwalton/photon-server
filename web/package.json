{
	"name": "photon-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun x --bun vite dev",
		"build": "bun x --bun vite build",
		"preview": "bun x --bun vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test src",
		"test:e2e": "playwright test",
		"api": "go -C .. run ./cmd/photon-server openapi > openapi.json && openapi-typescript openapi.json --output src/lib/api/schema.d.ts && rm openapi.json"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.15",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-bun": "^1",
		"@sveltejs/kit": "^3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.7.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	}
}
