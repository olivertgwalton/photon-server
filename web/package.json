{
	"name": "photon-web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun x --bun vite dev",
		"build": "bun x --bun vite build",
		"preview": "bun x --bun vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test src",
		"test:e2e": "playwright test",
		"api": "go -C .. run ./cmd/photon-server openapi > openapi.json && openapi-typescript openapi.json --output src/lib/api/schema.d.ts && rm openapi.json"
	},
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@biomejs/biome": "^2.6.8",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/manrope": "^5.3.0",
		"@fontsource-variable/space-grotesk": "^5.3.0",
		"@lucide/svelte": "^1.77.0",
		"@playwright/test": "^1.65.1",
		"@scalar/api-reference": "^1.82.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/bun": "^1.4.5",
		"@types/chromecast-caf-sender": "^1.0.11",
		"bits-ui": "^2.22.0",
		"cn": "^0.5.2",
		"embla-carousel-svelte": "^8.6.0",
		"hls.js": "^1.7.4",
		"jassub": "^2.5.38",
		"libbitsub": "^1.13.2",
		"openapi-typescript": "^7.13.0",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"openapi-fetch": "^0.17.0"
	}
}
