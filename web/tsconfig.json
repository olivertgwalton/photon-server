{
	"extends": "$app/tsconfig",
	"include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"],
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"sourceMap": true,
		"types": ["bun", "$app/types"]
	}
}
